# Copy to .env.local for local dev, and set the same keys in Netlify → Site configuration → Environment variables.
# All are public (NEXT_PUBLIC_) and are baked into the static build, so rebuild after changing them.

# Final site URL (canonical links, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://endolift.harleystreetaesthetic.co.uk

# Tracking. Loads ONLY after cookie consent. Leave blank to disable.
# If you use GTM, configure GA4/Meta inside GTM and leave the other two blank.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
